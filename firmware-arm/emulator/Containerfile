# The rabbit emulator, in a container, so it needs nothing but podman.
#
#   podman build -t nabaztag-emulator -f firmware-arm/emulator/Containerfile .
#   podman run --rm nabaztag-emulator
#
# Build it from the repository root: the context needs firmware-arm/crypto
# (the AES nabgcc lacks), firmware-arm/apply-mods.py, and the bytecode image
# under nabaztag-violet/ that the whole-rabbit target links in. ./run.sh does
# all of that and is the easier way in.
#
# The nabgcc commit is pinned to the same one the firmware Dockerfile builds,
# so the emulator and the thing that gets flashed are the same code.
FROM debian:bookworm-slim

ARG NABGCC_COMMIT=2c05b53fe4b17506cfff6570b9f1624ff7c2cdc3
# Which apply-mods.py steps to apply. The default is every network-stack fix
# that is merged, so `./run.sh` is green on a fresh clone; drop steps to
# measure one in isolation -- that is the whole point of naming them, and
# dropping these four is how wpa2-mixed-gtk, wpa2-rekey and wpa2-ptk-rekey
# fail, which is what they were written to show.
ARG MOD_STEPS=wpa2_gtk,eapol_group_ack,group_cipher,eapol_ptk_rekey,audio_halfduplex

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential git python3 ca-certificates \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /build
RUN git clone https://github.com/RedoXyde/nabgcc.git \
 && cd nabgcc \
 && git checkout "$NABGCC_COMMIT"

# nabgcc's src/net/aes128.c is a stub: every function is empty, while
# eapol.c calls it to unwrap the WPA2 group key. The emulator must use the
# real one or it would be testing nothing.
COPY firmware-arm/crypto/aes128.c /build/nabgcc/src/net/aes128.c
COPY firmware-arm/crypto/aes128.h /build/nabgcc/inc/net/aes128.h

# Run the same modifications the flashed firmware gets, so a fix can be tried
# here before it costs a power cycle.
COPY firmware-arm/apply-mods.py /build/apply-mods.py
RUN python3 /build/apply-mods.py --steps "$MOD_STEPS" /build/nabgcc

# Two changes the emulator needs and the hardware does not: a simulated
# register window, because a host cannot write to 0xB8000000, and one trace in
# the interpreter. Both are compiled out when _NAB_SIM is absent.
COPY firmware-arm/emulator/patches /build/patches
RUN cd /build/nabgcc \
 && git apply /build/patches/sim-mmio.patch \
 && git apply /build/patches/opnetauth-trace.patch

COPY firmware-arm/crypto             /build/crypto
COPY firmware-arm/emulator           /build/emulator
COPY nabaztag-violet/bootcode.hybrid /build/bootcode.hybrid

WORKDIR /build/emulator
RUN make NABGCC=/build/nabgcc BYTECODE=/build/bootcode.hybrid all vm

# Every Wi-Fi scenario, with the exit status that says whether they all held.
CMD ["make", "NABGCC=/build/nabgcc", "check"]
