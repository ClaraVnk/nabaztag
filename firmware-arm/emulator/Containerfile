# The rabbit emulator, in a container, so it needs nothing but podman.
#
#   podman build -t nabaztag-emulator -f firmware-arm/emulator/Containerfile .
#   podman run --rm nabaztag-emulator
#
# Build it from the repository root: the context needs firmware-arm/crypto
# (the AES nabgcc lacks), firmware-arm/apply-mods.py, and the bytecode image
# under nabaztag-violet/ that the whole-rabbit target links in. ./run.sh does
# all of that and is the easier way in.
#
# The nabgcc commit is pinned to the same one the firmware Dockerfile builds,
# so the emulator and the thing that gets flashed are the same code.
# Rocky, like the Terrier's image and the host it runs on: one family, one
# package manager. Not Alpine, small as it is: musl has no AddressSanitizer,
# and `make asan` is what found the stale heap pointer in the signature check
# (2026-11-08) -- an emulator that cannot run it has lost its best detector.
FROM quay.io/rockylinux/rockylinux:10

ARG NABGCC_COMMIT=2c05b53fe4b17506cfff6570b9f1624ff7c2cdc3
ARG MTL_LINUX_COMMIT=7e557a15373523f819e49d57e7a9c5419327b651
# Which apply-mods.py steps to apply. The default is every network-stack fix
# that is merged, so `./run.sh` is green on a fresh clone; drop steps to
# measure one in isolation -- that is the whole point of naming them, and
# dropping these four is how wpa2-mixed-gtk, wpa2-rekey and wpa2-ptk-rekey
# fail, which is what they were written to show.
# vbc, vinterp and sign_open_alias are the verifySig opcode and the one-buffer
# fix to crypto_sign_open that every flashed mode carries; vm_bounds likewise.
# Without them a whole-rabbit run cannot reach an OTA's signature gate at all,
# and what it tests upstream of the gate is not the VM the rabbit runs.
ARG MOD_STEPS=vbc,vinterp,stdlib,x25519_wdt,sign_open_alias,verify_wdt,vm_bounds,wpa2_gtk,eapol_group_ack,group_cipher,eapol_msg2_ie,eapol_ptk_rekey,eapol_replay,audio_halfduplex,extbss,no_libc_malloc,wpa3_sae,wpa3_boot_pw,wpa3_eapol_akm,entropy_pool,rx_protected,eapol_ptk_install,eapol_mic_len,gtk_no_reinstall,no_tkip_pairwise,sae_required,wpa3_h2e,adoption_kx,tls_psk,link_liveness,crash_report,flash_precheck,ccmp_replay_count

RUN dnf -y install --setopt=install_weak_deps=False \
      gcc make git python3 ca-certificates libasan libubsan diffutils \
 && dnf clean all && rm -rf /var/cache/dnf

WORKDIR /build
# nabgcc and its mtl/mtl_linux compiler are vendored in the repo at the commits
# named above (firmware-arm/vendor/, see its README), so the image builds with
# no network and survives the upstream repositories disappearing.
COPY firmware-arm/vendor/nabgcc /build/nabgcc

# nabgcc's src/net/aes128.c is a stub: every function is empty, while
# eapol.c calls it to unwrap the WPA2 group key. The emulator must use the
# real one or it would be testing nothing.
COPY firmware-arm/crypto/aes128.c /build/nabgcc/src/net/aes128.c
COPY firmware-arm/crypto/aes128.h /build/nabgcc/inc/net/aes128.h

# Run the same modifications the flashed firmware gets, so a fix can be tried
# here before it costs a power cycle.
# The SAE crypto, staged where patch_wpa3_sae expects to find it: outside
# the nabgcc tree, so that step lists without wpa3_sae do not compile it.
COPY firmware-arm/crypto/p256.c firmware-arm/crypto/p256.h \
     firmware-arm/crypto/sha256.c firmware-arm/crypto/sha256.h \
     firmware-arm/crypto/cmac.c firmware-arm/crypto/cmac.h \
     firmware-arm/crypto/sae.c firmware-arm/crypto/sae.h \
     firmware-arm/crypto/nab_kx.c firmware-arm/crypto/nab_kx.h \
     firmware-arm/crypto/nab_kx_vm.c \
     firmware-arm/crypto/nab_tls.c firmware-arm/crypto/nab_tls.h \
     firmware-arm/crypto/nab_tls_vm.c \
     firmware-arm/crypto/nab_rng.c firmware-arm/crypto/nab_rng.h \
     firmware-arm/crypto/nab_pki.h firmware-arm/crypto/nab_bn.c firmware-arm/crypto/nab_rsa.c \
     firmware-arm/crypto/nab_ecdsa.c firmware-arm/crypto/nab_x509.c firmware-arm/crypto/nab_sha384.c \
     firmware-arm/crypto/chachapoly.c firmware-arm/crypto/chachapoly.h firmware-arm/crypto/nab_https_vm.c \
     /build/sae-crypto/

# TweetNaCl goes where the firmware Dockerfile puts it, so sign_open_alias
# patches the copy this build compiles and not a vendored one it never sees.
COPY firmware-arm/upstream/tweetnacl/tweetnacl.c /build/nabgcc/src/crypto/tweetnacl.c
COPY firmware-arm/upstream/tweetnacl/tweetnacl.h /build/nabgcc/inc/tweetnacl.h
# Two changes the emulator needs and the hardware does not: a simulated
# register window, because a host cannot write to 0xB8000000, and one trace in
# the interpreter. Both are compiled out when _NAB_SIM is absent.
COPY firmware-arm/emulator/patches /build/patches
RUN cd /build/nabgcc \
 && git apply /build/patches/sim-mmio.patch \
 && git apply /build/patches/opnetauth-trace.patch

# After the two patches above, not before: the vinterp and vm_bounds steps
# rewrite vinterp.c with one line ending, and a diff taken against the
# original no longer applies to the rewritten file.
COPY firmware-arm/apply-mods.py /build/apply-mods.py
# boot_https builds its anchor from keys/ (the proof's own root, for
# tools/boot-https-proof.sh: BOOT_ANCHOR_FILE=proof_boot_anchor.der).
COPY firmware-arm/keys               /build/keys
ARG BOOT_ANCHOR_FILE=boot_anchor.der
RUN NAB_SIM=1 NAB_BOOT_ANCHOR=/build/keys/$BOOT_ANCHOR_FILE python3 /build/apply-mods.py --steps "$MOD_STEPS" /build/nabgcc

COPY firmware-arm/crypto             /build/crypto
# The VM target compiles crypto/nab_sig.c, which includes tweetnacl.h, and the
# public key the verifier is built around. Neither was copied in, so the
# documented `./run.sh --vm` could not build in a clean container.
COPY firmware-arm/upstream           /build/upstream
COPY firmware-arm/emulator           /build/emulator
# The SAE known-answer vectors: the virtual AP checks its own H2E against
# them before every run (src/vaph2e.c).
COPY firmware-arm/tests/vectors_h2e.h /build/tests/vectors_h2e.h
COPY nabaztag-violet/bootcode.hybrid /build/bootcode.hybrid

WORKDIR /build/emulator
RUN make NABGCC=/build/nabgcc BYTECODE=/build/bootcode.hybrid all vm

# Every Wi-Fi scenario, with the exit status that says whether they all held.
CMD ["make", "NABGCC=/build/nabgcc", "check"]
