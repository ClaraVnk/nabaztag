# Added to 2.6.32's versatile_defconfig: EABI (musl), an initramfs, the
# wireless stack with mac80211_hwsim's two radios, and what hostapd and
# wpa_supplicant use (packet and unix sockets). nl80211 is part of cfg80211
# on 2.6.32: no option of its own.
CONFIG_AEABI=y
CONFIG_OABI_COMPAT=n
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_WIRELESS_EXT=y
CONFIG_MAC80211=y
CONFIG_MAC80211_RC_MINSTREL=y
CONFIG_MAC80211_RC_DEFAULT_MINSTREL=y
CONFIG_MAC80211_HWSIM=y
CONFIG_WLAN_80211=y
CONFIG_CRYPTO=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_ARC4=y
CONFIG_CRYPTO_ECB=y
CONFIG_CRYPTO_CBC=y
