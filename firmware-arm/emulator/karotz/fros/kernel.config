# Added to versatile_defconfig. The Karotz's root is a cramfs ramdisk
# (rootfs.fros001.img, gzip'd in mtd2) handed over as an initrd.
CONFIG_AEABI=y
CONFIG_OABI_COMPAT=n
CONFIG_BLK_DEV_INITRD=y
CONFIG_BLK_DEV_RAM=y
CONFIG_BLK_DEV_RAM_COUNT=2
CONFIG_BLK_DEV_RAM_SIZE=16384
CONFIG_CRAMFS=y
CONFIG_CRAMFS_BLOCKDEV=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# /usr (yaffs2 on the rabbit) comes back as an ext2 image on a SCSI disk
# behind Versatile's PCI bridge. Not the SD slot: QEMU's PL181 on this board
# never brought a card up (no mmcblk0, 2026-11-17).
CONFIG_PCI=y
CONFIG_PCI_VERSATILE=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI_SYM53C8XX_2=y
# linuxrc writes /proc/sys/kernel/hotplug.
CONFIG_UEVENT_HELPER=y
CONFIG_EXT2_FS=y
CONFIG_EXT4_FS=y
CONFIG_TMPFS=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_SMC91X=y
# The RFID reader is on /dev/i2c-0 (rfid-daemon); Versatile has a bus.
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_VERSATILE=y
