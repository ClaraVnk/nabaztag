# Terrier OS's install, run against a simulated flash: the ground the update
# from the rabbit's page stands on (Terrier OS, LapinLibre's install).
#
# The kernel is 2.6.32.71 for ARM Versatile, as in ../wpa3, with nandsim
# cut as the Karotz's flash (mtd1 the kernel, mtd2 the root filesystem;
# 2 KiB pages and 128 KiB blocks are assumed, a Samsung K9F2G08's ids: /usr is yaffs2, a large-page
# format, and nothing measured says otherwise). The rest is a released
# Terrier OS image, pinned by its sha256: its root filesystem is the
# initramfs (its own bash, busybox, flash_erase and nandwrite), its key's
# files are in /mnt/usbkey, and init.sh runs the key's install as the rabbit
# does, then checks the flash and /usr.
#
#   podman build -t karotz-ota firmware-arm/emulator/karotz/ota
#   podman run --rm karotz-ota
FROM docker.io/library/alpine:3.22 AS kernel
RUN apk add --no-cache build-base gcc-arm-none-eabi binutils-arm-none-eabi bc perl xz patch curl
ARG KSHA=60a5ffe0206a0ea8997c29ccc595aa7dae55f6cb20c7d92aab88029ca4fef598
RUN curl -fsSLO https://cdn.kernel.org/pub/linux/kernel/v2.6/longterm/v2.6.32/linux-2.6.32.71.tar.xz && \
    echo "${KSHA}  linux-2.6.32.71.tar.xz" | sha256sum -c - && tar xJf linux-2.6.32.71.tar.xz
ARG LL_COMMIT=e26916806a8c7876559c61e07b3a1d586787a752
ARG GCC_PATCH_SHA=2c908adbeeccd4881a2bacf0c4c53007899477fb5edb9e16827abf809496cfc9
RUN curl -fsSL -o /modern-gcc.patch \
      "https://raw.githubusercontent.com/sweetlilmre/LapinLibre/${LL_COMMIT}/system/kernel/linux-2.6.32-modern-gcc.patch" && \
    echo "${GCC_PATCH_SHA}  /modern-gcc.patch" | sha256sum -c -
COPY kernel.config /kernel.config
COPY build-kernel.sh /build-kernel.sh
RUN sh /build-kernel.sh && cc -o /out/gen_init_cpio /k/usr/gen_init_cpio.c

FROM docker.io/library/alpine:3.22 AS image
RUN apk add --no-cache curl xz mtools python3
COPY uncramfs.py /uncramfs.py
ARG TOS=v0.2.0-50-ga60c9e8f14c5
ARG TOS_SHA=f55e2f90de4f8887df6812530c4e53c23433bd9fe7e8e2d25ceb87f4a76a316d
RUN curl -fsSL -o /t.img.xz \
      "https://github.com/ClaraVnk/nabaztag/releases/download/terrier-os-${TOS}/terrier-os-${TOS}.img.xz" && \
    echo "${TOS_SHA}  /t.img.xz" | sha256sum -c - && xz -d /t.img.xz && \
    mkdir -p /out/key && mcopy -s -i /t.img@@1M ::/* /out/key/ && \
    mkdir /r && cd /r && gunzip -c /out/key/rootfs.img.gz > /r/rootfs.cramfs && \
    python3 /uncramfs.py /r/rootfs.cramfs /out/rootfs && \
    test -x /out/rootfs/bin/bash && test -x /out/rootfs/sbin/nandwrite

FROM docker.io/library/alpine:3.22
RUN apk add --no-cache qemu-system-arm python3
COPY --from=kernel /out/ /ota/
COPY --from=image /out/ /ota/
COPY init.sh cpio-list.py run.sh /ota/
CMD ["sh", "/ota/run.sh"]
