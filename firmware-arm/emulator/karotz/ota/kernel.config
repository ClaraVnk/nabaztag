# Added to 2.6.32's versatile_defconfig: EABI (Terrier OS's binaries), an
# initramfs, and a simulated NAND flash (nandsim) cut as the Karotz's is, so
# that LapinLibre's install writes its kernel and root filesystem with its
# own flash_erase and nandwrite. The RAM disk is the Karotz's 5 MiB one: the
# install checks the unpacked root filesystem against /sys/block/ram0/size.
CONFIG_AEABI=y
CONFIG_OABI_COMPAT=n
CONFIG_BLK_DEV_INITRD=y
CONFIG_BLK_DEV_RAM=y
CONFIG_BLK_DEV_RAM_COUNT=1
CONFIG_BLK_DEV_RAM_SIZE=5120
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_MTD=y
CONFIG_MTD_PARTITIONS=y
CONFIG_MTD_CHAR=y
CONFIG_MTD_BLOCK=y
CONFIG_MTD_NAND=y
CONFIG_MTD_NAND_NANDSIM=y
