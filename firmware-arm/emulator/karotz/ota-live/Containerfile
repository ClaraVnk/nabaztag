# Terrier OS updated while the whole rabbit runs (2026-11-21, after Gengar):
# karotz/ota runs the install alone; here it runs on a booted Terrier OS --
# its own linuxrc, init, startup.sh, daemons, controller, and the Terrier's
# client from /usr/etc/conf/terrier -- with the command the client runs
# (0.1.18), then the rabbit boots the root filesystem the install wrote,
# with the /usr it left. Linux 6.12 on Versatile with ../fros's stand-ins for
# the rabbit's devices and nandsim cut as the Karotz's flash. A released
# image, pinned by sha256. The emulator's only changes to the rabbit's
# root: /usr on a disk, QEMU's network card for the Wi-Fi, the proof's hook
# at the end of startup.sh, a reboot that copies the flash first (root.sh).
#
# The package is make-ota.py's (unsigned: the client's signature check has
# its own proof, karotz/ota), as the Terrier serves it.
#
#   podman build -t karotz-ota-live -f firmware-arm/emulator/karotz/ota-live/Containerfile .
#   podman run --rm karotz-ota-live
#   podman run --rm -v <a built key dir>:/key:ro,Z karotz-ota-live   # a build not released yet:
#       the rabbit runs the released image, and updates to that key's build
FROM docker.io/library/alpine:3.24 AS kernel
RUN apk add --no-cache build-base gcc-arm-none-eabi binutils-arm-none-eabi \
        bc bison flex perl xz openssl-dev elfutils-dev linux-headers
ARG KVER=6.12.116
ARG KSHA=cb3ed3dfdd47e6ade49dc933db334fd86e24cadee920da612c262b0e9b6a511b
RUN wget -q https://cdn.kernel.org/pub/linux/kernel/v6.x/linux-$KVER.tar.xz \
 && echo "$KSHA  linux-$KVER.tar.xz" | sha256sum -c - \
 && tar xJf linux-$KVER.tar.xz && rm linux-$KVER.tar.xz
COPY firmware-arm/emulator/karotz/ota-live/kernel.config /kernel.config
COPY firmware-arm/emulator/karotz/fros/karotz_stubs.c /karotz_stubs.c
RUN cd linux-$KVER \
 && cp /karotz_stubs.c drivers/char/ && echo 'obj-y += karotz_stubs.o' >> drivers/char/Makefile \
 && make -s ARCH=arm CROSS_COMPILE=arm-none-eabi- versatile_defconfig \
 && scripts/kconfig/merge_config.sh -m .config /kernel.config >/dev/null \
 && make -s ARCH=arm CROSS_COMPILE=arm-none-eabi- olddefconfig \
 && grep -q '^CONFIG_MTD_NAND_NANDSIM=y' .config && grep -q '^CONFIG_MTD_NAND_ECC_SW_HAMMING=y' .config && ! grep -q '^CONFIG_MTD_PHYSMAP=y' .config \
 && make -s -j"$(nproc)" ARCH=arm CROSS_COMPILE=arm-none-eabi- zImage dtbs \
 && mkdir /out && cp arch/arm/boot/zImage arch/arm/boot/dts/arm/versatile-pb.dtb /out/

FROM docker.io/library/alpine:3.24 AS image
RUN apk add --no-cache curl xz mtools python3
COPY karotz/lapinlibre/make-ota.py /mk/karotz/lapinlibre/make-ota.py
COPY firmware-arm/signing/ed25519.py /mk/firmware-arm/signing/ed25519.py
ARG TOS=v0.2.0-50-ga60c9e8f14c5
ARG TOS_SHA=f55e2f90de4f8887df6812530c4e53c23433bd9fe7e8e2d25ceb87f4a76a316d
RUN curl -fsSL -o /t.img.xz \
      "https://github.com/ClaraVnk/nabaztag/releases/download/terrier-os-${TOS}/terrier-os-${TOS}.img.xz" && \
    echo "${TOS_SHA}  /t.img.xz" | sha256sum -c - && xz -d /t.img.xz && \
    mkdir -p /out/key && mcopy -s -i /t.img@@1M ::/* /out/key/ && rm -f /out/key/nov. && \
    python3 /mk/karotz/lapinlibre/make-ota.py /out/key /tmp/pkg && \
    mkdir /out/pkg && cp -a /tmp/pkg/*.ota/. /out/pkg/ && rm -f /out/pkg/manifest /out/pkg/manifest.sig

FROM docker.io/library/alpine:3.24
RUN apk add --no-cache qemu-system-arm python3 e2fsprogs e2fsprogs-extra util-linux-misc gzip
COPY --from=kernel /out/ /ota/
COPY --from=image /out/ /ota/
COPY firmware-arm/emulator/karotz/ota/uncramfs.py firmware-arm/emulator/karotz/ota-live/root.sh firmware-arm/emulator/karotz/ota-live/phase.sh firmware-arm/emulator/karotz/ota-live/run.sh /ota/
COPY karotz/lapinlibre/make-ota.py /mk/karotz/lapinlibre/make-ota.py
COPY firmware-arm/signing/ed25519.py /mk/firmware-arm/signing/ed25519.py
CMD ["sh", "/ota/run.sh"]
