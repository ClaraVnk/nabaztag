Wrap the ARM7 interrupt vector table, the startup code, the embedded
Metal bytecode region and the .ramfunc section in KEEP() so a future
`--gc-sections` linker run can't prune them.

These sections are referenced ONLY by hardware:
  - .intvec is read by the ARM7TDMI on reset / exception
  - .startup.cstartup contains the actual Reset_Handler body (entry
    point references it via the symbol, but the section itself isn't
    pulled in by any C call)
  - .ramfunc holds flash_uc which runs while flash is being rewritten
    (referenced via function pointer)
  - .bytecode holds the compiled boot.mtl blob (referenced from C via
    a linker symbol, but gc-sections still likes KEEP for blobs)

Upstream `ml67q4051.ld` has no KEEP() at all — fine today (gc-sections
is not enabled), but it's a foot-gun the second anyone turns gc-sections
on.

--- a/sys/ml67q4051.ld
+++ b/sys/ml67q4051.ld
@@ -21,8 +21,8 @@
   /* first section is .text which is used for code */
   .text :
   {
-    *(.intvec)
-    *(.startup.*)
+    KEEP(*(.intvec))
+    KEEP(*(.startup.*))
     *(.text.*)                   /* remaining code */
     *(.glue_7t) *(.glue_7)
   } >IntROM
@@ -38,7 +38,7 @@
   /* Bytecode */
   .bytecode :
   {
-    *(.bytecode.*)
+    KEEP(*(.bytecode.*))
   } >IntROM
   _etext = . ;
   PROVIDE (etext = .);
@@ -49,7 +49,7 @@
     _data = . ;
     *(.data.*)
       . = ALIGN(4);
-    *(.ramfunc)
+    KEEP(*(.ramfunc))
     SORT(CONSTRUCTORS)
   } >IntRAM
   . = ALIGN(4);
