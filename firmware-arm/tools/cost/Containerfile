# The image run.sh and ct.sh run in: qemu-arm to execute ARM7TDMI Thumb code
# in user mode and count its instructions, arm-none-eabi-gcc to build it with
# the firmware's flags, and a host gcc for the throwaway signing tool.
#
#   podman build -t localhost/nab-qemu -f firmware-arm/tools/cost/Containerfile .
#
# Counts depend on the compiler: results-2026-11-08.txt came from gcc 12.2,
# so compare runs made with the same image, never across images.
FROM docker.io/library/alpine:3.22
RUN apk add --no-cache bash python3 gcc musl-dev \
        gcc-arm-none-eabi binutils-arm-none-eabi newlib-arm-none-eabi qemu-arm
