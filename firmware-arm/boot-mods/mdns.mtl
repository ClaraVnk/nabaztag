// mdns.mtl — boot-loader mDNS announcer for "naboot.local".
//
// Identical wire shape to bytecode/mdns.mtl (the runtime bytecode mDNS):
// every 60 s, send an mDNS A response to 224.0.0.251:5353 mapping
// "naboot.local" to the current netip. Adapted for boot.mtl context.
//
// Why in the boot.mtl too: the runtime mDNS only kicks in AFTER the
// rabbit has fetched its bytecode from the configured server. If that
// fetch fails (server down, DNS bad), the rabbit is parked in the boot
// stage with WiFi up but nothing announcing — opaque from the LAN. With
// this loop running, "naboot.local" still resolves so HA / a human can
// SSH-equivalent diagnose. Also useful in master/AP mode: when joining
// the Nabaztag-XXXX AP, "naboot.local" resolves to 192.168.0.1 so the
// user doesn't have to memorize the IP.
//
// Design choices match the runtime version:
//   - 40-byte DNS message held as one literal and reused; only the 4 IP
//     bytes change per tick.
//   - destination MAC is the canonical multicast MAC 01:00:5e:00:00:fb
//     (RFC 1112 §6.4) so we bypass ARP for the class-D 224.0.0.251.
//   - netip is checked for non-nil before every send.

// 224.0.0.251
const MDNS_BOOT_IP="\224\0\0\$fb";;
const MDNS_BOOT_PORT=5353;;
// 01:00:5e:00:00:fb
const MDNS_BOOT_MAC="\1\0\$5e\0\0\$fb";;

// The whole message as one literal (a 40-byte string costs 40 bytes; forty
// strset calls cost 337): header id=0 flags=0x8400 one answer, the name
// 6"naboot" 5"local" 0, type A, class IN with cache-flush, TTL 120,
// RDLENGTH 4, and four RDATA bytes filled at announce time.
var mdns_boot_pkt="\0\0\$84\0\0\0\0\1\0\0\0\0\6naboot\5local\0\0\1\$80\1\0\0\0x\0\4\0\0\0\0";;
var mdns_boot_last=0;;

fun mdns_boot_announce=
	if netip==nil then 0
	else (
		strset mdns_boot_pkt 36 (strget netip 0);
		strset mdns_boot_pkt 37 (strget netip 1);
		strset mdns_boot_pkt 38 (strget netip 2);
		strset mdns_boot_pkt 39 (strget netip 3);
		udpsend netip MDNS_BOOT_PORT MDNS_BOOT_IP MDNS_BOOT_PORT mdns_boot_pkt MDNS_BOOT_MAC;
		0
	);;

// Called from the boot loop. `time` is the seconds counter (already used
// elsewhere in this file). Cheap when there's nothing to do.
fun mdns_boot_tick=
	if (time - mdns_boot_last) >= 60 then
	(
		mdns_boot_announce;
		set mdns_boot_last = time;
		0
	);;
