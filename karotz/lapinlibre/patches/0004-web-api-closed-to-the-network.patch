diff --git a/image/usbkey/applysettings.sh b/image/usbkey/applysettings.sh
index 0fa0c93..16d5b56 100644
--- a/image/usbkey/applysettings.sh
+++ b/image/usbkey/applysettings.sh
@@ -162,6 +162,16 @@ else
     rm -f "${CONF}/web_password" "${CONF}/web_password.new" "${CONF}/web_password.hash"
     LOG "Settings: no web password"
 fi
+# Terrier OS: a drawn password is the client's alone, which runs on the rabbit itself: then the web
+# API answers the rabbit only (inetd.sh), nothing on the network can reach it. A password the owner
+# chose is the owner's way in from the network: the API stays open to it, with the login (Terrier
+# OS review, 2026-11-24, Clara: "fermé par défaut").
+if [ -n "${WEB_PASSWORD_DRAWN}" ]; then
+    : > "${CONF}/web_local_only" || ERROR "can't close the web API to the network"
+    LOG "Settings: web API for the rabbit itself only"
+else
+    rm -f "${CONF}/web_local_only"
+fi
