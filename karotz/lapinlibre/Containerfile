# Builds LapinLibre (Karotz firmware, sweetlilmre/LapinLibre) from our fork's
# wpa3-tests branch (wpa3 + the tests made to pass outside the author's machine): WPA3 = SAE + 802.11w on the RT73 (nabaztag #178, upstream
# LapinLibre#1). On Ubuntu 24.04, the host upstream builds and tests on: an
# exception to our Alpine-or-Rocky rule, asked by Clara (2026-11-19, "fais
# ubuntu on sera sûr que ça marche"). Only the build host: nothing of Ubuntu
# reaches the rabbit, which runs LapinLibre's own Buildroot system.
FROM docker.io/library/ubuntu:24.04
ARG LL_REPO=https://github.com/ClaraVnk/LapinLibre.git
ARG LL_COMMIT=06830c2
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates sudo python3 \
 && git clone "$LL_REPO" /ll && git -C /ll checkout -q "$LL_COMMIT" \
 && cd /ll && bash scripts/host-prereqs.sh --install \
 && apt-get install -y --no-install-recommends iproute2 shellcheck busybox qemu-user-static python3-gi \
    net-tools \
 && ln -s /bin/busybox /usr/local/bin/usleep && rm -rf /var/lib/apt/lists/* \
 && for c in reboot halt poweroff shutdown; do [ -e /usr/sbin/$c ] || \
      printf '#!/bin/sh\necho "%s: not in a build container" >&2\nexit 1\n' $c > /usr/sbin/$c; \
      chmod 755 /usr/sbin/$c; done
# The harness binds its no-op stubs over /sbin/reboot, halt, poweroff,
# shutdown, ifconfig and route, but only where they exist (harness.py
# sbin_stub_mounts); a container has none of them, so the controller's
# "System rebooting" ran a /sbin/reboot that wasn't there and failed
# (2026-11-20). net-tools brings ifconfig and route; the four others are
# placeholders that refuse, never run: the stubs cover them in the tests.
# iproute2, shellcheck, usleep and python3-gi (the controller tests' fake
# D-Bus daemons): the tests call them (tests/, shutil.which
# and ["ip", ...]) but host-prereqs.sh does not install them; without usleep
# the rabbit's CGI scripts answered 1 and 276 web API tests failed (2026-11-19).
# Terrier OS's own changes to LapinLibre (patches/README.md), one commit on
# LL_COMMIT with a fixed date: the same tree and the same `git describe`
# (the lapinlibre-base provenance line) from one build to the next.
# test-patches.sh checks they apply before a build is started.
COPY patches/ /patches/
# Applied to the work tree, then everything added: host-prereqs.sh above
# touches inetd.sh and applysettings.sh, and `git apply --index` refused
# them ("does not match index", the first build with patches, 2026-11-25).
RUN cd /ll && for p in /patches/*.patch; do git apply "$p"; done && git add -A \
 && GIT_AUTHOR_DATE=2026-11-24T00:00:00Z GIT_COMMITTER_DATE=2026-11-24T00:00:00Z \
    git -c user.name="Terrier OS" -c user.email=build@example.com commit -q -m "Terrier OS patches" \
 && git describe --tags --match "v[0-9]*" --abbrev=12
WORKDIR /ll
# The work tree (downloads, Buildroot output) on the volume: a rebuild redoes
# only what changed.
# As an ordinary user, the way upstream builds: as root, tar restores each
# archive's owner, and rootless podman cannot map uid 819312 (liblockfile,
# 2026-11-19). build.sh runs it with --userns=keep-id, so /work is ours.
RUN useradd -m -u 1000 builder 2>/dev/null || true; chown -R 1000:1000 /ll
USER 1000
ENV LAPINLIBRE_WORK=/work/ll
# The stages in LL_STAGES (build.sh leaves out the tests unless LL_TESTS=1;
# empty = every stage, the tests included); the key is copied to /work.
CMD ["sh", "-c", "./build.sh $LL_STAGES && rm -rf /work/usbkey && cp -r /work/ll/out/usbkey /work/usbkey && echo BUILD-OK"]
