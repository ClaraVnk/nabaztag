# Builds LapinLibre (Karotz firmware, sweetlilmre/LapinLibre) from our fork's
# wpa3 branch: WPA3 = SAE + 802.11w on the RT73 (nabaztag #178, upstream
# LapinLibre#1). On Ubuntu 24.04, the host upstream builds and tests on: an
# exception to our Alpine-or-Rocky rule, asked by Clara (2026-11-19, "fais
# ubuntu on sera sûr que ça marche"). Only the build host: nothing of Ubuntu
# reaches the rabbit, which runs LapinLibre's own Buildroot system.
FROM docker.io/library/ubuntu:24.04
ARG LL_REPO=https://github.com/ClaraVnk/LapinLibre.git
ARG LL_COMMIT=3da1370
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates sudo python3 \
 && git clone "$LL_REPO" /ll && git -C /ll checkout -q "$LL_COMMIT" \
 && cd /ll && bash scripts/host-prereqs.sh --install && rm -rf /var/lib/apt/lists/*
WORKDIR /ll
# The work tree (downloads, Buildroot output) on the volume: a rebuild redoes
# only what changed.
# As an ordinary user, the way upstream builds: as root, tar restores each
# archive's owner, and rootless podman cannot map uid 819312 (liblockfile,
# 2026-11-19). build.sh runs it with --userns=keep-id, so /work is ours.
RUN useradd -m -u 1000 builder 2>/dev/null || true; chown -R 1000:1000 /ll
USER 1000
ENV LAPINLIBRE_WORK=/work/ll
# Every stage, the tests included; the key is copied to the /work volume.
CMD ["sh", "-c", "./build.sh && rm -rf /work/usbkey && cp -r /work/ll/out/usbkey /work/usbkey && echo BUILD-OK"]
