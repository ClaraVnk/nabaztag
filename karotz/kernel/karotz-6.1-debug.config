# Added on top of karotz-6.1.config for the emulator only (step 2): the
# kernel's own early serial output on UART0, before its console driver is up.
# Not shipped: it costs bytes and the Karotz's console is not wired to anyone.
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_LL=y
CONFIG_DEBUG_S3C_UART0=y
CONFIG_EARLY_PRINTK=y
CONFIG_DEBUG_UNCOMPRESS=y
# The root file system as an initrd (LapinLibre's cramfs on /dev/ram0): the
# step 2 shell. QEMU's NAND model is not one 6.1 identifies ("No NAND device
# found", then an oops in the driver's error path), and the NAND is step 3's
# work on nandsim anyway.
CONFIG_BLK_DEV_INITRD=y
CONFIG_BLK_DEV_RAM=y
# CONFIG_MTD_NAND_S3C2410 is not set
