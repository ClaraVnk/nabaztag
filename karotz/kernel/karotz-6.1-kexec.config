# On top of karotz-6.1-debug.config and karotz-6.1-realnand.config, for the
# 6.1 started by kexec from a USB key (karotz/kexec/): no size limit there.
# KALLSYMS lets initcall_blacklist= name the drivers, to find the one 6.1
# stops in on a real Karotz (2026-11-23: no trace of 6.1 on Gengar, while
# kexec into 2.6.32 ran the measure).
CONFIG_KALLSYMS=y
