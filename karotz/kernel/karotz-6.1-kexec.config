# On top of karotz-6.1-debug.config and karotz-6.1-realnand.config, for the
# 6.1 started by kexec from a USB key (karotz/kexec/): no size limit there.
# KALLSYMS lets initcall_blacklist= name the drivers, to find the one 6.1
# stops in on a real Karotz (2026-11-23: no trace of 6.1 on Gengar, while
# kexec into 2.6.32 ran the measure).
CONFIG_KALLSYMS=y
# /dev/mem: the measure leaves its log in RAM the 6.1 kernel does not use
# (written just before the restart, at 0x33E00000), restarts the rabbit, the
# 2.6.32 key autorun saves it: the only trace with no LED and no USB proven.
CONFIG_DEVMEM=y
# ramoops (2026-11-23): 6.1 still stopped on Gengar before the measure's end
# with eight drivers off, and nothing could tell where. Its console now goes
# to 1 MiB of RAM it is given no use of (mem=..@.. around 0x32000000); the
# watchdog 2.6.32 arms before the jump restarts the board, RAM kept, and the
# 2.6.32 key autorun saves that MiB: the kernel's last lines.
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
