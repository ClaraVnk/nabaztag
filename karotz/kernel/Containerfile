# Linux 6.1 LTS for the Karotz (Samsung S3C2440A, ARM920T): the size proof,
# step 1 of docs/TERRIER-OS-KERNEL.md. 6.1 is the last LTS with the S3C24xx
# platform. Alpine (our rule), its bare-metal ARM GCC: enough for a kernel.
#
#   podman build -t karotz-kernel61 -f karotz/kernel/Containerfile karotz/kernel
#   podman run --rm karotz-kernel61
FROM docker.io/library/alpine:3.24
RUN apk add --no-cache build-base bc bison flex perl xz curl gcc-arm-none-eabi \
      binutils-arm-none-eabi linux-headers openssl-dev elfutils-dev python3 diffutils findutils
ARG LINUX=6.1.192
# kernel.org's sha256sums.asc for v6.x.
ARG LINUX_SHA256=1e88e317e20dbc79a2cb9e3d9667e908b262d12e76eb66eed894c5460eb87fca
RUN curl -fsSL -o /linux.tar.xz "https://cdn.kernel.org/pub/linux/kernel/v6.x/linux-${LINUX}.tar.xz" && \
    echo "${LINUX_SHA256}  /linux.tar.xz" | sha256sum -c - && \
    mkdir /linux && tar -xJf /linux.tar.xz -C /linux --strip-components=1 && rm /linux.tar.xz
# YAFFS (step 3): the Karotz's /usr is YAFFS1. yaffs2/ is Yocto's port of
# Aleph One's code to 6.1 (its README); hooked in as fs/yaffs2.
COPY yaffs2/ /linux/fs/yaffs2/
RUN rm /linux/fs/yaffs2/README.md && \
    sed -i 's#^source "fs/jffs2/Kconfig"#&\nsource "fs/yaffs2/Kconfig"#' /linux/fs/Kconfig && \
    echo 'obj-$(CONFIG_YAFFS_FS) += yaffs2/' >> /linux/fs/Makefile && \
    grep -q 'fs/yaffs2/Kconfig' /linux/fs/Kconfig
# YAFFS1 on 512-byte pages (the Karotz's NAND, 16 bytes of OOB): the mount
# chose in-band tags whenever the OOB could not hold YAFFS2's tags, also
# for YAFFS1, which then refused itself ("NAND geometry problems ... inband
# 1", 2026-11-22). The test is for YAFFS2 only.
COPY yaffs1-small-page.patch /k/
# nandsim (step 3, the emulator only: the shipped config has no nandsim)
# gets noecc=1, the Karotz's NAND without ECC.
COPY nandsim-noecc.patch /k/
# YAFFS1's tags as every kernel after 2.6.17 wrote them, the Karotz's
# 2.6.32 included (yaffs1-mtd1/: 2009's yaffs_mtdif1.c, ported): today's
# YAFFS writes the 16-byte spare of before, which neither fits the free OOB
# nor reads an existing /usr.
COPY yaffs1-mtd1/ /linux/fs/yaffs2/
COPY yaffs1-mtd1.patch /k/
RUN cd /linux && patch -p1 < /k/yaffs1-small-page.patch && patch -p1 < /k/nandsim-noecc.patch && \
    patch -p1 < /k/yaffs1-mtd1.patch
# 6.1's spidev binds only the names in its table, not "spidev": the Karotz's
# LED driver gets its own (step 4, 2026-11-22).
COPY spidev-karotz.patch spi-s3c24xx-devres.patch s3c2410-nand-inithw.patch /k/
# spi-s3c24xx's setup put a devres on the spi device before its probe, and
# the driver core refused every device on that bus (step 4, 2026-11-22).
RUN cd /linux && patch -p1 < /k/spidev-karotz.patch && patch -p1 < /k/spi-s3c24xx-devres.patch
# The NAND controller enabled before the chip is read: 6.1 scanned first,
# which worked only behind a bootloader that had left it on (2026-11-22).
RUN cd /linux && patch -p1 < /k/s3c2410-nand-inithw.patch
# The internal hub's devices, powered by the board, not refused for want of
# bus power (Gengar, 2026-11-24). Under test since SLUB fixed the hub
# (2026-11-25): USB_POWER_PATCH=0 builds without it, for five boots of
# Gengar; it goes if they all find the hub's devices.
ARG USB_POWER_PATCH=1
COPY usb-bus-power-rabbitv3.patch /k/
RUN [ "$USB_POWER_PATCH" = 0 ] || (cd /linux && patch -p1 < /k/usb-bus-power-rabbitv3.patch)
# The DMA status after a transfer has ended (s3c24xx-dma-tx-status.patch): the
# sound card's stop crashed the kernel on Gengar, 2026-11-24.
COPY s3c24xx-dma-tx-status.patch /k/
RUN cd /linux && patch -p1 < /k/s3c24xx-dma-tx-status.patch
# The Karotz's board file (step 4): machine 1912, ported from 2.6.32.
COPY rabbitv3/ /k/rabbitv3/
RUN sh /k/rabbitv3/hook.sh /linux
# The kexec and hub-test fragments too (the kexec one was mounted by hand
# until 2026-11-24: EXTRA names them as /k/...).
COPY karotz-6.1.config karotz-6.1-debug.config karotz-6.1-realnand.config \
     karotz-6.1-kexec.config size.sh /k/
CMD ["sh", "/k/size.sh"]
