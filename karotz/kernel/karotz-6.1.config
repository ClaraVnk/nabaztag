# The Karotz on Linux 6.1: tinyconfig, then what the rabbit uses
# (LapinLibre docs/system.md, system/kernel/rabbitv3_defconfig). No board
# file of its own yet: mini2440, an S3C2440 board, stands in for the size.
CONFIG_KERNEL_XZ=y
# 6.1 hides S3C24xx behind these: an ARMv4T/v5-only kernel (no v7), and
# "board support for machines without known users" (the platform is
# deprecated, removed in 6.3).
# allnoconfig leaves the MMU off, and with it the multi-platform ARM
# kernel, ELF, shmem and tmpfs.
CONFIG_MMU=y
CONFIG_ARCH_MULTIPLATFORM=y
# CONFIG_ARCH_MULTI_V7 is not set
# CONFIG_ARCH_MULTI_V6 is not set
CONFIG_UNUSED_BOARD_FILES=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_ARCH_MULTI_V4T=y
CONFIG_ARCH_S3C24XX=y
CONFIG_CPU_S3C2440=y
CONFIG_MACH_MINI2440=y
CONFIG_AEABI=y
CONFIG_ATAGS=y
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_POSIX_TIMERS=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_BLK_DEV_RAM=y
CONFIG_BLK_DEV_RAM_SIZE=5120
CONFIG_MISC_FILESYSTEMS=y
CONFIG_CRAMFS=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_UNIX=y
# tinyconfig turns these off; Wi-Fi, the USB stick and the RAM disk need them.
CONFIG_NETDEVICES=y
CONFIG_BLOCK=y
CONFIG_SND_OSSEMUL=y
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_SERIAL_SAMSUNG=y
CONFIG_SERIAL_SAMSUNG_CONSOLE=y
CONFIG_TTY=y
CONFIG_MTD=y
CONFIG_MTD_BLOCK=y
CONFIG_MTD_RAW_NAND=y
CONFIG_MTD_NAND_S3C2410=y
CONFIG_WLAN=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_RT2X00=y
CONFIG_RT73USB=y
CONFIG_FW_LOADER=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_CCM=y
CONFIG_CRYPTO_GCM=y
CONFIG_CRYPTO_CMAC=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PLATFORM=y
CONFIG_USB_STORAGE=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_USB_GADGET=y
CONFIG_USB_S3C2410=y
CONFIG_USB_G_SERIAL=y
CONFIG_SPI=y
CONFIG_SPI_S3C24XX=y
CONFIG_SPI_SPIDEV=y
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_S3C2410=y
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_PCM_OSS=y
CONFIG_SND_SOC=y
# The I2S needs its DMA channel: without the S3C24xx DMA driver the card
# never registered ("s3c24xx-iis: Missing dma channel for stream: 0", -22),
# on Gengar and in QEMU alike (2026-11-23).
CONFIG_DMADEVICES=y
CONFIG_S3C24XX_DMAC=y
CONFIG_SND_SOC_SAMSUNG=y
CONFIG_SND_SOC_SAMSUNG_S3C24XX_UDA134X=y
CONFIG_MEDIA_SUPPORT=y
CONFIG_VIDEO_DEV=y
CONFIG_V4L_PLATFORM_DRIVERS=y
# The camera interface driver needs power management.
CONFIG_PM=y
CONFIG_VIDEO_S3C_CAMIF=y
CONFIG_VIDEO_OV7670=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_S3C=y
CONFIG_GPIOLIB=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_PWM=y
CONFIG_PWM_SAMSUNG=y
CONFIG_WATCHDOG=y
CONFIG_S3C2410_WATCHDOG=y

# /usr: YAFFS1 with the options of LapinLibre's rabbitv3_defconfig, so the
# 6.1 kernel reads and writes what 2.6.32 wrote (step 3). The NAND has no
# ECC: YAFFS does its own. (2.6.32's DISABLE_WIDE_TNODES and
# SHORT_NAMES_IN_RAM were RAM-only and are gone from today's YAFFS.)
CONFIG_MTD_BLOCK=y
CONFIG_YAFFS_FS=y
CONFIG_YAFFS_YAFFS1=y
# CONFIG_YAFFS_9BYTE_TAGS is not set
CONFIG_YAFFS_DOES_ECC=y
# CONFIG_YAFFS_ECC_WRONG_ORDER is not set
CONFIG_YAFFS_YAFFS2=y
CONFIG_YAFFS_AUTO_YAFFS2=y
CONFIG_YAFFS_ALWAYS_CHECK_CHUNK_ERASED=y

# Step 4: the Karotz's own board file (rabbitv3/), machine 1912, beside
# MINI2440's (QEMU's board, for the emulator). Its devices' drivers: spidev
# for the LED driver.
CONFIG_MACH_RABBITV3=y
CONFIG_SPI_SPIDEV=y
# The bootloader's own command line, extended: the internal hub enumerates
# only with the old scheme (Gengar, 2026-11-24: its descriptor read empty
# otherwise, about every other boot). usb-bus-power-rabbitv3.patch does the
# rest: the hub's devices are not refused for want of bus power.
# console=ttySAC0: the BIOS's line names no console and 2.6.32 took its VT
# ("console [tty0] enabled", Gengar's dmesg); 6.1 has no VT and, booted by
# the BIOS in QEMU, enabled none at all: it ran (the NAND traffic of its
# YAFFS mount) and said nothing, and linuxrc's /dev/console went nowhere
# (bios-boot.sh, 2026-11-25). The serial header is the rabbit's only
# console; naming it costs a second of printk at 115200 baud.
CONFIG_CMDLINE="usbcore.old_scheme_first=1 console=ttySAC0,115200"
CONFIG_CMDLINE_EXTEND=y

# Terrier OS's own programs (uClibc, built for 2.6.32) call the 32-bit time
# syscalls: nanosleep, clock_gettime, select's timeval. Without them each
# fails with ENOSYS: Gengar's linuxrc under 6.1 slept 300 s in no time and
# never waited on anything (ramoops, 2026-11-24).
CONFIG_COMPAT_32BIT_TIME=y
# Terrier OS's network.sh tells association by `iwconfig` (wireless
# extensions): without them Gengar under 6.1 had its address and still
# opened the setup network, "no network" (2026-11-24).
CONFIG_CFG80211_WEXT=y
# flock(2): LapinLibre's API takes its one hardware lock with flock (web.sh
# web_lock). Without FILE_LOCKING every ears/LEDs request from the Terrier
# client answered "busy" under 6.1 (Gengar, 2026-11-24, flock: Function
# not implemented).
CONFIG_FILE_LOCKING=y

# Review of 2026-11-24 (REVIEW-6.1.md). syscalls-audit.py against Terrier
# OS's root: dbus-daemon and glib's gio import inotify, which this kernel
# answered with ENOSYS (2.6.32 had CONFIG_INOTIFY).
CONFIG_INOTIFY_USER=y
# A kernel that panics restarts the rabbit by itself after 10 s: the BIOS
# adds nothing to the command line, so panic= goes here, not in CMDLINE.
CONFIG_PANIC_TIMEOUT=10
# The tick as 2.6.32's rabbitv3 config had it (HZ=200): tinyconfig left 100,
# which halves the resolution of every sleep, poll and timer the daemons use
# (led-daemon steps its pulses every 30 ms; no high-resolution timers in
# either kernel). Not yet seen on Gengar.
CONFIG_HZ_200=y
# olddefconfig kept these on; no swap device, no BSD ptys: size and surface.
# CONFIG_SWAP is not set
# CONFIG_LEGACY_PTYS is not set
# The S3C24xx OHCI glue (the "s3c2410-ohci" os-prelude rebinds), which
# olddefconfig took by default: named, so a default change cannot drop it.
CONFIG_USB_OHCI_HCD_S3C2410=y

# The internal hub's wrong control reads (REVIEW-6.1.md 1.1, 2026-11-24):
# tinyconfig picks SLOB, which prepends a 32-byte size header to each
# kmalloc and does not round the size up, so the free space after a 2-, 4-,
# 8-, 15- or 18-byte USB buffer (hub status, hub->buffer, hub descriptor,
# device descriptor) is in the buffer's own cache line, and SLOB keeps its
# free-list words there. The ARM920T invalidates that line when the buffer
# is mapped for the device and never again (proc-arm920.S: dma_unmap_area
# is empty); any allocation in the page between the map and the read pulls
# the line, stale, back into the cache, and the CPU reads what was there
# before the transfer: zeros for a kzalloc'd descriptor ("hub doesn't have
# any ports"), 0 for the status (bus-powered), old bytes for a device
# descriptor (bad descriptor). The old scheme's 64-byte buffer fills its
# lines, which is why usbcore.old_scheme_first=1 cured that one read.
# 2.6.32's config had SLAB. SLUB's kmalloc classes are multiples of 32 on
# ARM (KMALLOC_MIN_SIZE = ARCH_KMALLOC_MINALIGN), each buffer in lines of
# its own. The two workarounds stay until Gengar confirms (RUNBOOK).
CONFIG_SLUB=y
# CONFIG_SLOB is not set

# ramoops in the flash kernel (FLASH-PLAN step 1): the board file reserves
# 1 MiB at 0x32000000 and registers the device, the next boot's autorun
# reads it (karotz/kexec/ramoops.py). Was in the kexec fragment only.
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
# The BIOS's line carries "quiet", which drops every line below KERN_WARNING
# from the console, ramoops included: the first flash boots would leave no
# "rabbitv3: clocks", no "pstore: Registered". With this, "quiet" keeps
# KERN_INFO (7 = debug off); nobody reads the serial port on a rabbit, and
# ramoops is read by the next boot's autorun. In QEMU the BIOS-booted 6.1
# shows its boot on the serial console (bios-boot.sh).
CONFIG_CONSOLE_LOGLEVEL_QUIET=7
