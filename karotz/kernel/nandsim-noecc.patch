 #define NS_LARGEST_PAGE_SIZE	4096
@@ -2199,6 +2202,17 @@
 {
 	unsigned int eccsteps, eccbytes;
 
+	/*
+	 * noecc=1: no ECC at all, as the Karotz's NAND runs (mach-rabbitv3.c,
+	 * disable_ecc = 1; YAFFS1 does its own). The software ECC this
+	 * simulator imposed took OOB bytes YAFFS1 writes its tags into: every
+	 * write failed its read-back (Terrier OS kernel step 3, 2026-11-22).
+	 */
+	if (noecc) {
+		chip->ecc.engine_type = NAND_ECC_ENGINE_TYPE_NONE;
+		return 0;
+	}
+
 	chip->ecc.engine_type = NAND_ECC_ENGINE_TYPE_SOFT;
 	chip->ecc.algo = bch ? NAND_ECC_ALGO_BCH : NAND_ECC_ALGO_HAMMING;
 
