#!/bin/sh
# The USB host and its clocks, read on a Karotz under either kernel: what
# the hub question needs measured (REVIEW-6.1.md 1.1, FLASH-PLAN step 1,
# 2026-11-24). Written to a file, read-only on the rabbit, a few seconds.
#
#   usb-measure <out file> [label]
#
# The key's autorun calls it under 2.6.32 before a kexec (usb-2632.txt
# beside before.txt) and under 6.1 (usb-61.txt in the N-os-6.1 directory),
# so each run of the key leaves both. The label says what Clara knows and
# the rabbit cannot: "cold" (from the mains) or "warm" (a restart, a kexec).
# The registers need /dev/mem: Terrier OS's 2.6.32 and the kexec 6.1 have
# it, the flash 6.1 (no CONFIG_DEVMEM) says so and gives the rest.
#
# What to compare, cold against warm and 2.6.32 against 6.1:
# - UPLLCON must read 00038022 everywhere (56/2/2, 48 MHz: the BIOS writes
#   it at power-on, 2.6.32 at its map_io, 6.1's board file since 11-24);
#   CLKSLOW bit 7 (0x80) set = UPLL off; CLKCON bit 6 (0x40) = USB host
#   clock gated off; MISCCR bit 3 = port 1 as host (0 on this board),
#   bits 12/13 = ports suspended.
# - HcRhPortStatus1 (0x49000054): 0x00000103 = a device connected, port
#   enabled and powered; 0x00000100 = powered, nothing connected: the hub
#   itself not seen. HcControl bits 7:6 = 10 operational.
# - The hub 1-1 (0451:2046) and what is behind it: 1-1.3 the Wi-Fi
#   (148f:2573), 1-1.N the key. Under 2.6.32 /proc/bus/usb/devices has the
#   tree; under 6.1 /sys/bus/usb/devices.
# - The kernel's own lines on the hub: "local power source is good"
#   (2.6.32, self-powered), "bad descriptor", "doesn't have any ports",
#   "insufficient available bus power" (6.1 before the SLUB kernel).
OUT=${1:?out file}
LABEL=${2:-}
exec > "$OUT" 2>&1
echo "== usb-measure $LABEL $(date) up $(cut -d' ' -f1 /proc/uptime)s"
uname -r
echo "== cmdline"; cat /proc/cmdline
reg() { printf '%-10s %08X ' "$1" "$2"; devmem "$2" 32 2>&1; }
if [ -c /dev/mem ] && command -v devmem > /dev/null 2>&1; then
	echo "== clocks (0x4C000000)"
	reg LOCKTIME 0x4C000000; reg MPLLCON 0x4C000004; reg UPLLCON 0x4C000008
	reg CLKCON 0x4C00000C; reg CLKSLOW 0x4C000010; reg CLKDIVN 0x4C000014
	echo "== gpio"
	reg MISCCR 0x56000080; reg GPFCON 0x56000050; reg GPFDAT 0x56000054
	reg GPGCON 0x56000060; reg GPGDAT 0x56000064; reg GPGUP 0x56000068
	reg GPCDAT 0x56000024
	echo "== ohci (0x49000000)"
	reg HcRevision 0x49000000; reg HcControl 0x49000004; reg HcCmdStatus 0x49000008
	reg HcIntStatus 0x4900000C; reg HcFmInterval 0x49000034; reg HcFmNumber 0x4900003C
	reg HcRhDescA 0x49000048; reg HcRhDescB 0x4900004C; reg HcRhStatus 0x49000050
	reg HcRhPort1 0x49000054; reg HcRhPort2 0x49000058
else
	echo "== no /dev/mem or devmem: registers not read (the flash 6.1 has no CONFIG_DEVMEM)"
fi
echo "== usb tree"
if [ -f /proc/bus/usb/devices ]; then
	grep -E "^(T|P|S|C|I):" /proc/bus/usb/devices
elif [ -d /sys/bus/usb/devices ]; then
	for d in /sys/bus/usb/devices/[0-9]*; do
		[ -f "$d/idVendor" ] || continue
		printf '%s %s:%s speed=%s cfg=%s maxpower=%s attrs=%s\n' "$(basename "$d")" \
			"$(cat "$d/idVendor")" "$(cat "$d/idProduct")" "$(cat "$d/speed")" \
			"$(cat "$d/bConfigurationValue" 2> /dev/null)" "$(cat "$d/bMaxPower" 2> /dev/null)" \
			"$(cat "$d/bmAttributes" 2> /dev/null)"
	done
	echo "ports behind 1-1: $(ls -d /sys/bus/usb/devices/1-1/1-1-port* 2> /dev/null | wc -l), devices: $(ls -d /sys/bus/usb/devices/1-1.[0-9]* 2> /dev/null | wc -l)"
	[ -f /sys/bus/usb/devices/1-1/1-1:1.0/maxchild ] && echo "maxchild: $(cat /sys/bus/usb/devices/1-1/1-1:1.0/maxchild)"
else
	echo "no usb tree"
fi
echo "== net"; ls /sys/class/net 2> /dev/null | tr '\n' ' '; echo
echo "== disks"; ls /dev/sd* /dev/ub* 2> /dev/null | tr '\n' ' '; echo
echo "== dmesg (usb, hub, ohci, rabbitv3 clocks)"
dmesg | grep -iE "ohci|hub |usb 1-|rabbitv3: (clocks|upll|usb)|descriptor|bus power|power source|UPLL|uclk" | tail -60
