#!/bin/sh
# FLASH-PLAN step 6: the Karotz's ramdisk partition (mtd2) written, read
# back and compared, as flash-kernel does the kernel. Both kernels boot this
# ramdisk (step 2): a wrong one and neither starts, the head button's restore
# the only way out. So nothing is written unless all of this holds:
#
#   <key>/flash/rootfs-new.img.gz   the ramdisk to write (gzip -t passes)
#   <key>/flash/rootfs-old.img.gz   the one in mtd2 now, byte for byte
#   <key>/flash/MD5SUMS-ramdisk     md5sum of both, checked first
#   <key>/flash/go-ramdisk          write rootfs-new at this run (then removed)
#   <key>/flash/go-ramdisk-back     write rootfs-old instead (then removed)
#
# mtd2 must read back as rootfs-old before (or rootfs-new, for the way
# back), the partition must be the board's "ramdisk", both must fit. A
# read-back that differs is written once more; a second one writes the other
# image back, read back too. Log: <key>/flash/log.txt. /usr, mtd1: untouched.
# Then sync and reboot -f (FLASH_NO_REBOOT=1: not).
K=${KEY:-/mnt/usbkey}
F=$K/flash
LOG=$F/log.txt
MTD=${FLASH_RAMDISK_MTD:-/dev/mtd2}
log() { echo "$(date '+%Y-%m-%d %H:%M:%S') $*" >> "$LOG"; }

if [ -e "$F/go-ramdisk" ]; then IMG=$F/rootfs-new.img.gz; NOW=$F/rootfs-old.img.gz; WHAT=new
elif [ -e "$F/go-ramdisk-back" ]; then IMG=$F/rootfs-old.img.gz; NOW=$F/rootfs-new.img.gz; WHAT=old
else exit 0
fi
rm -f "$F/go-ramdisk" "$F/go-ramdisk-back"
log "start: the $WHAT ramdisk into $MTD, under $(uname -r)"

( cd "$F" && md5sum -c MD5SUMS-ramdisk ) >> "$LOG" 2>&1 || { log "STOP: MD5SUMS-ramdisk do not hold, nothing written"; sync; exit 1; }
gzip -t "$IMG" 2>> "$LOG" || { log "STOP: $(basename "$IMG") is not a whole gzip, nothing written"; sync; exit 1; }
name=$(basename "$MTD")
size=$(awk -v d="$name:" '$1 == d { print $2 }' /proc/mtd)
[ -n "$size" ] || { log "STOP: $MTD not in /proc/mtd, nothing written"; sync; exit 1; }
size=$((0x$size))
n=$(wc -c < "$IMG")
[ "$n" -le "$size" ] || { log "STOP: $(basename "$IMG") is $n bytes, $MTD holds $size; nothing written"; sync; exit 1; }
want=${FLASH_RAMDISK_NAME-ramdisk}
[ -z "$want" ] || awk -v d="$name:" '$1 == d' /proc/mtd | grep -q "\"$want\"" \
    || { log "STOP: $MTD is not the \"$want\" partition; nothing written"; sync; exit 1; }
ws=$(cat "/sys/class/mtd/$name/writesize" 2> /dev/null || echo 2048)

same() {   # does $MTD hold $1, byte for byte?
    m=$(wc -c < "$1")
    rm -f /tmp/flash-rd.bin
    nanddump -q -l $(( (m + ws - 1) / ws * ws )) -f /tmp/flash-rd.bin "$MTD" >> "$LOG" 2>&1 \
        && head -c "$m" /tmp/flash-rd.bin | cmp -s - "$1"
    r=$?; rm -f /tmp/flash-rd.bin; return $r
}
same "$NOW" || { log "STOP: $MTD is not $(basename "$NOW"), the ramdisk expected there; nothing written"; sync; exit 1; }
log "$MTD holds $(basename "$NOW") as expected"

mkdir -p "$F/conf-backup" && cp -a /usr/etc/conf/. "$F/conf-backup/" 2> /dev/null
log "settings copied to the key ($(ls "$F/conf-backup" | wc -l) entries)"

write_and_check() {
    flash_erase -q "$MTD" 0 0 >> "$LOG" 2>&1 || { log "flash_erase failed"; return 1; }
    nandwrite -q -p -m "$MTD" "$1" >> "$LOG" 2>&1 || { log "nandwrite failed"; return 1; }
    same "$1" || { log "read-back differs from $(basename "$1")"; return 1; }
    log "read back: $(basename "$1"), $(wc -c < "$1") bytes, identical"
}

if write_and_check "$IMG" || { log "once more"; write_and_check "$IMG"; }; then
    log "DONE: the $WHAT ramdisk is in $MTD"
    rc=0
elif write_and_check "$NOW"; then
    log "FAILED: the $WHAT ramdisk did not read back twice; $(basename "$NOW") written back and read back"
    rc=2
else
    log "FAILED: nothing that reads back is in $MTD; the head button's restore is the way back (FLASH-PLAN step 0)"
    rc=3
fi
sync
[ "${FLASH_NO_REBOOT:-0}" = 1 ] || reboot -f
exit $rc
