# --- karotz/kexec os-prelude: Terrier OS under 6.1, traced (make-key.sh) ---
# Every command into the kernel's log, which ramoops keeps; fd 3, since
# linuxrc's tmpfs mount over /dev hides /dev/kmsg.
mount -t devtmpfs d /dev 2> /dev/null
exec 3> /dev/kmsg
exec >&3 2>&1
set -x
# A warm restart after 15 minutes (5 until 2026-11-24, time to send it commands): RAM survives for the next 2.6.32 to save
# (the first try, 2026-11-24, left nothing and its unplug wiped the log).
(sleep 900; sync; reboot -f) &
# Every process's state and where it waits in the kernel, every 20 s
# (2026-11-24: linuxrc stopped at its tmpfs /dev mount and the USB hub's
# devices never came).
(set +x
 while :; do
     sleep 20
     for d in /proc/[0-9]*; do
         read -r st < $d/stat
         echo "ps ${d#/proc/} $st $(cat $d/wchan 2> /dev/null)" | cut -c1-120
     done
 done) >&3 2>&1 &
# The internal hub (1-1) sometimes reads as having no ports ("config
# failed, hub doesn't have any ports! (err -19)", 2026-11-24): no key, no
# Wi-Fi. Measured here: whether a second probe (authorized 0 then 1)
# brings its devices back. Up to three tries, each logged.
(set +x
 U=/sys/bus/usb/devices
 # linuxrc mounts /sys a moment later (a sysfs of our own under /tmp was
 # hidden by its tmpfs, 2026-11-24): wait for it.
 while [ ! -d $U ]; do sleep 1; done
 # A hub whose descriptor reads as garbage ("bad descriptor, ignoring
 # hub", 2026-11-24 16:4x) stays so through three re-probes: then the
 # whole controller is unbound and bound again, which enumerates the bus
 # from its root, up to twice.
 O=/sys/bus/platform/drivers/s3c2410-ohci
 for try in 1 2 3 4 5; do
     sleep 8
     kids=$(ls -d $U/1-1.[0-9]* 2> /dev/null | wc -l)
     echo "hubfix: try $try, $kids device(s) behind 1-1"
     [ "$kids" -gt 0 ] && break
     if [ $try -ge 3 ] && [ -e $O/s3c2410-ohci ]; then
         echo "hubfix: controller unbind, bind"
         echo s3c2410-ohci > $O/unbind; sleep 2; echo s3c2410-ohci > $O/bind
         continue
     fi
     [ -e $U/1-1/authorized ] || { echo "hubfix: no 1-1"; continue; }
     echo 0 > $U/1-1/authorized; sleep 1; echo 1 > $U/1-1/authorized
 done
 sleep 8; echo "hubfix: now $(ls -d $U/1-1.[0-9]* 2> /dev/null | wc -l) device(s) behind 1-1") >&3 2>&1 &
# --- end of the prelude ---
